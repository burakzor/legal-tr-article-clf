{
  "config": {
    "seed": 42,
    "data_version": "v1",
    "out_dir": "outputs/input_length/logreg",
    "input_lengths": [
      5,
      10,
      20,
      40,
      80,
      160,
      null
    ],
    "tfidf": {
      "ngram_range": [
        1,
        2
      ],
      "min_df": 2,
      "max_features": 100000,
      "sublinear_tf": true
    },
    "model": {
      "class_weight": "balanced",
      "batch_size": 256,
      "max_epochs": 30,
      "patience": 3
    },
    "search": {
      "lr": [
        0.01,
        0.001
      ],
      "weight_decay": [
        0.0,
        1e-06,
        1e-05,
        0.0001
      ]
    },
    "bootstrap": {
      "n": 1000
    }
  },
  "device": "cuda",
  "created": "2026-11-20",
  "packages": {
    "numpy": "2.4.6",
    "pandas": "2.2.3",
    "scikit-learn": "1.6.1",
    "torch": "2.14.1+cu130"
  }
}
